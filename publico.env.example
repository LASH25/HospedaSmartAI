# Copia este archivo a publico.env y rellénalo. NO lo subas a ningún repositorio ni lo compartas.
# Correo y contraseña de la cuenta de servicio (usuario con rol RECEPCIONISTA creado en Usuarios).
PORTAL_EMAIL=portal@tu-hotel.mx
PORTAL_PASSWORD=
# Opcional: clave secreta de Cloudflare Turnstile (anti-bots). Vacío = sin verificación (solo para pruebas).
TURNSTILE_SECRET=
# Opcional: origen permitido si el sitio público está en otro dominio, p. ej. https://reservas.tu-hotel.mx
PUBLIC_ORIGIN=
# 1 solo cuando el servicio esté detrás del proxy HTTPS (fase 4). En pruebas locales déjalo en 0.
TRUST_PROXY=0
